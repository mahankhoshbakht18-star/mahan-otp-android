# Merge only these locations into the existing otp.mahanvip.ir HTTPS server AFTER approval.
# Preserve all existing TLS, licensing, legacy download and OTP locations.
location = /app/version.json {
    proxy_pass http://127.0.0.1:18019;
    proxy_set_header Host $host;
    add_header Cache-Control "no-store" always;
}
location = /api/app/version {
    proxy_pass http://127.0.0.1:18019;
    proxy_set_header Host $host;
    add_header Cache-Control "no-store" always;
}
location = /api/v1/bot/app/upload {
    client_max_body_size 100m;
    limit_req zone=mahan_bot burst=3 nodelay;
    proxy_pass http://127.0.0.1:18019;
    proxy_set_header Host $host;
    proxy_request_buffering off;
    proxy_read_timeout 120s;
}
location ~ "^/downloads/mahanbot-[a-f0-9]{64}\.apk$" {
    proxy_pass http://127.0.0.1:18019;
    proxy_set_header Host $host;
    add_header Cache-Control "no-store" always;
    proxy_read_timeout 120s;
    limit_except GET { deny all; }
}
